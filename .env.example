# Copy to .env and set values. Do not commit .env.

# ──────────── Required in production ────────────
DJANGO_SECRET_KEY=your-long-random-secret-key-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,app.yourdomain.com

# Set to false in production
DJANGO_DEBUG=false

# Optional: force HTTPS redirect (default true when DEBUG=false)
# DJANGO_HTTPS_ONLY=true

# ──────────── Database (optional) ────────────
# Use one of:
# 1) DATABASE_URL (PostgreSQL URL, e.g. from Heroku/Railway)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# 2) Or individual POSTGRES_* vars
# POSTGRES_DB=tt_osint
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# If neither is set, SQLite is used (fine for dev). On Heroku we use /tmp automatically.
# To use your own/original SQLite file (full path to the .sqlite3 file):
# SQLITE_DB_PATH=/path/to/your/db.sqlite3
# If you get "file is not a database" on another platform, set a writable dir:
# SQLITE_DB_DIR=/tmp

# ──────────── AI / Geocoding ────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

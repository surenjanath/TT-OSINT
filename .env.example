# Copy to .env and set values. Do not commit .env.

# ──────────── Required in production ────────────
DJANGO_SECRET_KEY=your-long-random-secret-key-here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,app.yourdomain.com

# Set to false in production
DJANGO_DEBUG=false

# Optional: force HTTPS redirect (default true when DEBUG=false)
# DJANGO_HTTPS_ONLY=true

# ──────────── Database (optional) ────────────
# Use one of:
# 1) DATABASE_URL (PostgreSQL URL, e.g. from Heroku/Railway)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# 2) Or individual POSTGRES_* vars
# POSTGRES_DB=tt_osint
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# If neither is set, SQLite (db.sqlite3) is used — fine for dev only.

# ──────────── AI / Geocoding ────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
